{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"],
      "@convex/*": ["convex/*"],
      "@assets/*": ["assets/*"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types",
    "convex/_generated",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}

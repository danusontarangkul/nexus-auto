{
  "expo": {
    "name": "Nexus Auto",
    "slug": "nexus-auto",
    "scheme": "nexus-auto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#022c7a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidanusontarangkul.nexusauto",
      "usesAppleSignIn": true,
      "icon": "./assets/icon.jpg",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to scan VINs and receipts.",
        "NSPhotoLibraryUsageDescription": "We access photos you select to read VINs and receipts.",
        "NSPhotoLibraryAddUsageDescription": "We can save processed images if you choose to."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#022c7a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.davidanusontarangkul.nexusauto"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/SpaceMono-Regular.ttf"]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication"
    ]
  }
}

{
  "expo": {
    "name": "Nexus Auto",
    "slug": "nexus-auto",
    "owner": "anusontarangkul.d",
    "scheme": "nexus-auto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#022c7a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidanusontarangkul.nexusauto",
      "usesAppleSignIn": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Nexus Auto uses the camera to scan VINs and maintenance receipts for your vehicle records.",
        "NSPhotoLibraryUsageDescription": "Nexus Auto accesses your photos to import existing images of VINs and service receipts.",
        "NSPhotoLibraryAddUsageDescription": "Nexus Auto saves processed images of your vehicle documents to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#022c7a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.davidanusontarangkul.nexusauto"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "da996db7-c90c-43b2-810a-72f0a83bbd31"
      }
    }
  }
}
